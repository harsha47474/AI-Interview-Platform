# ─── Server Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values

PORT=3000

# MongoDB connection string
MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/colloquium

# JWT secret — use a long random string in production
JWT_SECRET=your_super_secret_jwt_key_here

# OpenRouter AI API key (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Allowed frontend origins (comma-separated for multiple).
# In development this defaults to http://localhost:5173
# In production set to your deployed frontend URL:
# CLIENT_ORIGIN=https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173
